# ---------------------------------------------------------------
# {{ cookiecutter.project_name }} — copy to .env and adjust.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-insecure-secret-change-me
API_PREFIX=/api
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# Postgres (docker-compose defaults). For a quick local start without docker,
# switch to: sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/{{ cookiecutter.project_slug }}
DB_ECHO=false

# Auth
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis (caching, Celery broker, rate-limit storage)
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=300

# Rate limiting: fixed-window | fixed-window-elastic | moving-window |
#                sliding-window | token-bucket
RATE_LIMIT_STRATEGY=fixed-window
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# Email (SMTP). Leave HOST empty to run email as no-op in dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=no-reply@example.com

# Logging
LOG_JSON=false
LOG_LEVEL=INFO
DEFAULT_LOCALE=en
